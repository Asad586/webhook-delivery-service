generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
}

model Event {
  id              String   @id @default(uuid()) @db.Uuid
  source          String   @db.VarChar(64)
  providerEventId String   @map("provider_event_id") @db.VarChar(255)
  eventType       String   @map("event_type") @db.VarChar(128)
  payload         Json     @db.JsonB
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  deliveries  Delivery[]
  deadLetters DeadLetter[]

  @@unique([source, providerEventId])
  @@index([receivedAt])
  @@map("events")
}

model Subscriber {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(128)
  url        String   @db.Text
  secret     String   @db.Text
  eventTypes String[] @map("event_types")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries  Delivery[]
  deadLetters DeadLetter[]

  @@map("subscribers")
}

model Delivery {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  subscriberId   String         @map("subscriber_id") @db.Uuid
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt       DateTime?      @map("locked_at") @db.Timestamptz(3)
  lastError      String?        @map("last_error") @db.Text
  lastStatusCode Int?           @map("last_status_code")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  deadLetter DeadLetter?

  @@unique([eventId, subscriberId])
    // Pending-queue index is a partial index, created by hand in
  // migrations/20260819120000_partial_pending_index. Prisma cannot express
  // WHERE clauses on indexes.
  @@map("deliveries")
}

model DeadLetter {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryId     String   @unique @map("delivery_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  subscriberId   String   @map("subscriber_id") @db.Uuid
  attempts       Int
  lastError      String?  @map("last_error") @db.Text
  lastStatusCode Int?     @map("last_status_code")
  deadLetteredAt DateTime @default(now()) @map("dead_lettered_at") @db.Timestamptz(3)

  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([deadLetteredAt])
  @@map("dead_letters")
}